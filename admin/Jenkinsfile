pipeline {
	agent any

		environment {
			IMAGE_NAME = 'admin'
				IMAGE_TAG = "${BUILD_NUMBER}"  // auto increments each build
		}

	stages {

		stage('Checkout') {
			steps {
				echo '📥 Checking out code...'
					checkout scm
			}
		}

		stage('Build') {
			steps {
				dir('admin') {
					echo '🔨 Building jar...'
						sh './gradlew bootJar -x test'
				}
			}
		}

		stage('Docker Build') {
			steps {
				dir('admin') {
					echo '🐳 Building Docker image...'
						sh """
						podman build -t ${IMAGE_NAME}:${IMAGE_TAG} .
						podman tag ${IMAGE_NAME}:${IMAGE_TAG} ${IMAGE_NAME}:latest
						"""
				}
			}
		}

		stage('Docker Push') {
			steps {
				dir('admin') {
					echo '📦 Pushing to registry...'
						withCredentials([usernamePassword(
									credentialsId: 'java-admin-credentials',
									usernameVariable: 'USERNAME',
									passwordVariable: 'PASSWORD'
									)]) {
							// single quotes: the shell expands the secrets, so Groovy never interpolates them into the log
							sh '''
								echo "$PASSWORD" | podman login -u "$USERNAME" --password-stdin docker.io
								podman tag "$IMAGE_NAME:$IMAGE_TAG" "docker.io/$USERNAME/$IMAGE_NAME:$IMAGE_TAG"
								podman tag "$IMAGE_NAME:$IMAGE_TAG" "docker.io/$USERNAME/$IMAGE_NAME:latest"
								podman push "docker.io/$USERNAME/$IMAGE_NAME:$IMAGE_TAG"
								podman push "docker.io/$USERNAME/$IMAGE_NAME:latest"
							'''
						}
				}
			}
		}

		stage('Deploy') {
			steps {
				echo '🚀 Deploying...'
					sh 'podman-compose up -d --build java-admin-service'
			}
		}
	}

	post {
		success {
			echo '✅ Pipeline succeeded!'
		}
		failure {
			echo '❌ Pipeline failed!'
		}
		always {
			// clean up old images
			sh 'podman image prune -f'
		}
	}
}
